# MongoDB Atlas (cluster déjà existant côté client)
MONGODB_URI=
# Base séparée et jetable pour les tests d'intégration. Son nom doit contenir "test".
MONGODB_TEST_URI=

# Auth.js — génère avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=

# Resend (déjà utilisé côté legacy pour les emails transactionnels)
RESEND_API_KEY=

# Cloudinary (remplace Firebase Storage) 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Preset signé créé avec `npm run cloudinary:setup` : formats PDF/JPG/PNG,
# taille maximale 10 Mo et stockage authentifié.
CLOUDINARY_PRIVATE_UPLOAD_PRESET=liveinblack_private_documents
# Preset signé pour les vidéos/photos publiques envoyées directement au
# stockage (vidéos plafonnées à 30 Mo).
CLOUDINARY_PUBLIC_UPLOAD_PRESET=liveinblack_public_media

# Web Push standard (VAPID) — remplace Firebase Cloud Messaging. Génère la
# paire avec `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY et
# NEXT_PUBLIC_VAPID_PUBLIC_KEY doivent être IDENTIQUES (même clé publique,
# une copie serveur pour lib/server/push.ts, une copie exposée au navigateur
# pour lib/client/push.ts — Next.js n'expose au client que les variables
# préfixées NEXT_PUBLIC_). Sans ces clés, l'envoi push est un no-op silencieux
# (jamais de credential inventé, voir lib/server/push.ts::ensureConfigured).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@liveinblack.com

# Stripe (clés de TEST/sandbox pendant la migration — jamais les clés live avant la phase 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel aujourd'hui: le site utilise le checkout redirige serveur Stripe,
# pas Stripe.js cote navigateur. Garder seulement si une future UI client Stripe
# est ajoutee.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# FedaPay (mobile money, sandbox pendant la migration)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Site public (URLs de retour paiement — jamais déduit d'Origin/Host, cf. audit H06)
# Domaine public canonique. En production SEO, garder le domaine final,
# jamais localhost ni une URL preview *.vercel.app.
PUBLIC_SITE_URL=https://liveinblack.com
EXPECTED_PUBLIC_SITE_HOST=liveinblack.com

# Cron de versement organisateur (/api/cron/payouts) — génère avec `openssl rand -hex 32`.
# Échoue FERMÉ si absent (audit C09) : ne jamais laisser vide en production.
CRON_SECRET=

# Vercel Pro / Ops
# Connection string Edge Config injectee par Vercel quand l'Edge Config
# `liveinblack-ops` est liee au projet. Le site fonctionne avec des valeurs
# par defaut si elle est absente, mais les flags live ne seront pas lus.
EDGE_CONFIG=
# Token read optionnel si l'endpoint Edge Config n'inclut pas deja son token.
VERCEL_EDGE_CONFIG_READ_TOKEN=
# Token de bypass pour les deploiements proteges Vercel, utilise par les
# scripts smoke/load/deploy quand la protection preview/prod est active.
VERCEL_AUTOMATION_BYPASS_SECRET=
VERCEL_PROTECTION_BYPASS=
# Fenetre de scan runtime logs apres deploy (`1h`, `24h`, `7d`, ...).
VERCEL_LOGS_SINCE=1h
# Secret de signature si un Log Drain Vercel pointe vers un endpoint interne.
DRAIN_SECRET=
# Endpoint externe fiable pour creer un Vercel Drain (Datadog/Honeycomb/Sentry
# ou collecteur maison). Ne pas pointer vers le meme projet sans anti-boucle.
VERCEL_DRAIN_URL=
# Endpoint optionnel pour relayer les erreurs operationnelles vers un outil
# externe si l'equipe branche Sentry/Datadog/Honeycomb ou un collecteur maison.
ERROR_WEBHOOK_URL=
# Webhook Spend Management Vercel Pro: signature HMAC-SHA1 recue dans
# `x-vercel-signature` quand le webhook est cree dans le dashboard Billing.
VERCEL_SPEND_WEBHOOK_SECRET=
# Optionnel et desactive par defaut: a `1`, une alerte spend a 100% peut
# basculer `maintenance_mode=true` et `checkout_enabled=false` dans Edge Config.
VERCEL_SPEND_AUTO_MAINTENANCE=0
# Token API uniquement necessaire si `VERCEL_SPEND_AUTO_MAINTENANCE=1`.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_EDGE_CONFIG_ID=
# Webhooks Vercel Account/Project: deploiements, projets, domaines, etc.
# Secret affiche une seule fois a la creation du webhook Vercel.
VERCEL_ACCOUNT_WEBHOOK_SECRET=
# Endpoint et evenements optionnels pour le script de creation du webhook
# plateforme. Par defaut: PUBLIC_SITE_URL + /api/ops/vercel-events et
# deployment.created,deployment.ready.
VERCEL_ACCOUNT_WEBHOOK_URL=
VERCEL_ACCOUNT_WEBHOOK_EVENTS=
# Endpoint Spend Management a copier dans Billing > Spend Management.
VERCEL_SPEND_WEBHOOK_URL=

# Allowlist super-admin (remplacé phase 9 par un flag `superAdmin` en base — gardé ici en transition)
SUPER_ADMIN_EMAILS=

# Google Analytics 4 — Measurement ID (public, pas un secret). Script chargé
# uniquement si l'utilisateur a accepté les cookies (voir GoogleAnalytics.tsx
# + lib/shared/cookieConsent.ts), jamais avant.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Jetons de vérification des moteurs de recherche. Copier uniquement la valeur
# du jeton fournie par les outils webmaster, jamais la balise HTML complète :
# - Google : contenu de `<meta name="google-site-verification" content="...">`
# - Bing : contenu de `<meta name="msvalidate.01" content="...">`
# - Yandex : contenu de `<meta name="yandex-verification" content="...">`
# - Pinterest : contenu de `<meta name="p:domain_verify" content="...">`
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=
