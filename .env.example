# MongoDB Atlas (cluster déjà existant côté client)
MONGODB_URI=
# Base séparée et jetable pour les tests d'intégration. Son nom doit contenir "test".
MONGODB_TEST_URI=

# Auth.js — génère avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=

# Resend (déjà utilisé côté legacy pour les emails transactionnels)
RESEND_API_KEY=

# Cloudinary (remplace Firebase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Preset signé créé avec `npm run cloudinary:setup` : formats PDF/JPG/PNG,
# taille maximale 10 Mo et stockage authentifié.
CLOUDINARY_PRIVATE_UPLOAD_PRESET=liveinblack_private_documents
# Preset signé pour les vidéos/photos publiques envoyées directement au
# stockage (vidéos plafonnées à 30 Mo).
CLOUDINARY_PUBLIC_UPLOAD_PRESET=liveinblack_public_media

# Web Push standard (VAPID) — remplace Firebase Cloud Messaging. Génère la
# paire avec `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY et
# NEXT_PUBLIC_VAPID_PUBLIC_KEY doivent être IDENTIQUES (même clé publique,
# une copie serveur pour lib/server/push.ts, une copie exposée au navigateur
# pour lib/client/push.ts — Next.js n'expose au client que les variables
# préfixées NEXT_PUBLIC_). Sans ces clés, l'envoi push est un no-op silencieux
# (jamais de credential inventé, voir lib/server/push.ts::ensureConfigured).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@liveinblack.com

# Stripe (clés de TEST/sandbox pendant la migration — jamais les clés live avant la phase 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# FedaPay (mobile money, sandbox pendant la migration)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Site public (URLs de retour paiement — jamais déduit d'Origin/Host, cf. audit H06)
PUBLIC_SITE_URL=https://liveinblack.com

# Cron de versement organisateur (/api/cron/payouts) — génère avec `openssl rand -hex 32`.
# Échoue FERMÉ si absent (audit C09) : ne jamais laisser vide en production.
CRON_SECRET=

# Allowlist super-admin (remplacé phase 9 par un flag `superAdmin` en base — gardé ici en transition)
SUPER_ADMIN_EMAILS=

# Google Analytics 4 — Measurement ID (public, pas un secret). Script chargé
# uniquement si l'utilisateur a accepté les cookies (voir GoogleAnalytics.tsx
# + lib/shared/cookieConsent.ts), jamais avant.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
