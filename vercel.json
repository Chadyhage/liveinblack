{
  "regions": ["cdg1", "iad1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/webhooks/**/route.ts": {
      "maxDuration": 60
    },
    "app/api/stripe-webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/checkout/**/route.ts": {
      "maxDuration": 60
    },
    "app/api/event-orders/**/route.ts": {
      "maxDuration": 60
    },
    "app/api/agent-sales/**/route.ts": {
      "maxDuration": 60
    },
    "app/api/agent/payments/**/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/payouts", "schedule": "0 8 * * *" },
    { "path": "/api/cron/subscriptions", "schedule": "0 7 * * *" },
    { "path": "/api/cron/seat-holds", "schedule": "0 9 * * *" },
    { "path": "/api/cron/seat-hold-reminders", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/event-recap", "schedule": "0 * * * *" },
    { "path": "/api/cron/resale-expiry", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/cash-sale-reminders", "schedule": "0 10 * * *" },
    { "path": "/api/cron/interested-event-reminders", "schedule": "0 11 * * *" }
  ]
}
